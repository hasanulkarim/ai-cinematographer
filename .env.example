# --- Google Cloud / Vertex AI ---
USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
GOOGLE_CLOUD_LOCATION="us-central1"

# Only needed if USE_VERTEXAI=false (Gemini Developer API)
# GEMINI_API_KEY="your-gemini-api-key"

# --- Grafana Agent Observability (Generation Ingest) ---
AGENTO11Y_ENDPOINT=https://agento11y-prod-us-west-0.grafana.net
AGENTO11Y_PROTOCOL=http
AGENTO11Y_AUTH_MODE=basic
AGENTO11Y_AUTH_TENANT_ID=your-tenant-id
AGENTO11Y_AUTH_TOKEN="glc_your-grafana-cloud-token"

# --- OpenTelemetry (Traces & Metrics → Grafana Cloud) ---
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-us-west-0.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64(TENANT_ID:TOKEN)>
